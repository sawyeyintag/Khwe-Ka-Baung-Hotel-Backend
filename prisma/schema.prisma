// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model RoomType {
  id                    Int    @id @default(autoincrement())
  name                  String
  pax                   Int
  priceWithBreakfast    Float
  priceWithoutBreakfast Float
  rooms                 Room[]
}

model Room {
  roomNumber  String     @id
  floorNumber Int
  roomTypeId  Int
  sessions    Session[]
  roomItems   RoomItem[]
  roomType    RoomType   @relation(fields: [roomTypeId], references: [id])
}

model Session {
  id                  Int             @id @default(autoincrement())
  roomNumber          String
  sessionStatusId     Int
  roomPrice           Float
  numberOfExtraBeds   Int?
  extraBedPrice       Float?
  checkInAt           DateTime
  checkOutAt          DateTime
  note                String?
  isBreakfastIncluded Boolean         @default(false)
  isActive            Boolean         @default(true)
  guests              GuestSession[]
  otherReceipts       OtherReceipt[]
  receipt             SessionReceipt?
  room                Room            @relation(fields: [roomNumber], references: [roomNumber])
  sessionStatus       SessionStatus   @relation(fields: [sessionStatusId], references: [id])

  @@unique([roomNumber, checkInAt, checkOutAt])
}

model GuestSession {
  guestUid  String
  sessionId Int
  guest     Guest   @relation(fields: [guestUid], references: [uid])
  session   Session @relation(fields: [sessionId], references: [id])

  @@id([guestUid, sessionId])
}

model SessionStatus {
  id       Int       @id @default(autoincrement())
  name     String
  sessions Session[]
}

model SessionReceipt {
  id           Int      @id @default(autoincrement())
  sessionId    Int      @unique
  issuedAt     DateTime
  amountOfPaid Float
  discount     Float?
  totalPrice   Float
  session      Session  @relation(fields: [sessionId], references: [id])
}

model Guest {
  uid           String         @id @default(uuid())
  name          String
  phone         String
  email         String?
  address       String?
  nicCardNumber String?        @unique
  sessions      GuestSession[]
}

model OtherReceipt {
  id           Int                @id @default(autoincrement())
  amountOfPaid Float
  discount     Float?
  totalPrice   Float
  sessionId    Int
  session      Session            @relation(fields: [sessionId], references: [id])
  items        OtherReceiptItem[]
  services     Json?
}

model Item {
  id                Int                @id @default(autoincrement())
  name              String
  price             Float
  quantity          Int
  roomItems         RoomItem[]
  otherReceiptItems OtherReceiptItem[]
}

model RoomItem {
  roomNumber String
  itemId     Int
  quantity   Int
  room       Room   @relation(fields: [roomNumber], references: [roomNumber])
  item       Item   @relation(fields: [itemId], references: [id])

  @@id([roomNumber, itemId])
}

model OtherReceiptItem {
  otherReceiptId Int
  itemId         Int
  quantity       Int
  otherReceipt   OtherReceipt @relation(fields: [otherReceiptId], references: [id])
  item           Item         @relation(fields: [itemId], references: [id])

  @@id([otherReceiptId, itemId])
}
