// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model RoomType {
  id                    Int    @id @default(autoincrement())
  name                  String
  priceWithBreakfast    Float
  priceWithoutBreakfast Float
  pax                   Int
  rooms                 Room[]
}

model Room {
  roomNumber  String     @id
  floorNumber Int
  roomTypeId  Int
  roomType    RoomType   @relation(fields: [roomTypeId], references: [id])
  sessions    Session[]
  bookings    Booking[]
  roomItems   RoomItem[]
}

model Booking {
  id           Int      @id @default(autoincrement())
  roomNumber   String
  contactName  String
  contactPhone String
  contactEmail String?
  note         String?
  estCheckIn   DateTime
  estCheckOut  DateTime
  room         Room     @relation(fields: [roomNumber], references: [roomNumber])

  @@unique([roomNumber, estCheckIn, estCheckOut])
  @@index([roomNumber, estCheckIn, estCheckOut])
}

model Session {
  id                  Int             @id @default(autoincrement())
  roomNumber          String
  roomPrice           Float
  numberOfExtraBeds   Int?
  extraBedPrice       Float?
  checkInAt           DateTime
  checkOutAt          DateTime?
  note                String?
  isBreakfastIncluded Boolean         @default(false)
  isActive            Boolean         @default(true)
  room                Room            @relation(fields: [roomNumber], references: [roomNumber])
  guests              Guest[]
  receipt             SessionReceipt?
  otherReceipts       OtherReceipt[]

  @@unique([roomNumber, checkInAt, checkOutAt])
}

model SessionReceipt {
  id           Int      @id @default(autoincrement())
  sessionId    Int      @unique
  issuedAt     DateTime
  amountOfPaid Float
  discount     Float?
  totalPrice   Float
  session      Session  @relation(fields: [sessionId], references: [id])
}

model Guest {
  uid           String   @id @default(uuid())
  name          String
  phone         String
  email         String?
  address       String?
  nicCardNumber String?  @unique
  sessionId     Int?
  session       Session? @relation(fields: [sessionId], references: [id])
}

model OtherReceipt {
  id           Int                   @id @default(autoincrement())
  amountOfPaid Float
  discount     Float?
  totalPrice   Float
  sessionId    Int
  session      Session               @relation(fields: [sessionId], references: [id])
  items        OtherReceiptItem[]
  services     OtherReceiptService[]
}

model Item {
  id                Int                @id @default(autoincrement())
  name              String
  price             Float
  quantity          Int
  roomItems         RoomItem[]
  otherReceiptItems OtherReceiptItem[]
}

model RoomItem {
  roomNumber String
  itemId     Int
  quantity   Int
  room       Room   @relation(fields: [roomNumber], references: [roomNumber])
  item       Item   @relation(fields: [itemId], references: [id])

  @@id([roomNumber, itemId])
}

model Service {
  id                   Int                   @id @default(autoincrement())
  name                 String
  price                Float
  otherReceiptServices OtherReceiptService[]
}

model OtherReceiptService {
  otherReceiptId Int
  serviceId      Int
  quantity       Int
  otherReceipt   OtherReceipt @relation(fields: [otherReceiptId], references: [id])
  service        Service      @relation(fields: [serviceId], references: [id])

  @@id([otherReceiptId, serviceId])
}

model OtherReceiptItem {
  otherReceiptId Int
  itemId         Int
  quantity       Int
  otherReceipt   OtherReceipt @relation(fields: [otherReceiptId], references: [id])
  item           Item         @relation(fields: [itemId], references: [id])

  @@id([otherReceiptId, itemId])
}
