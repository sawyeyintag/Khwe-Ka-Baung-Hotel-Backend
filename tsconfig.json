{
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/shared/*": ["./shared/*"]
    }
  },
  "include": ["src/**/*", "shared/**/*", "prisma/**/*"],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
